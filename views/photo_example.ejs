<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Photo Lookup • Flickr Photo API</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/modal.js"></script>
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <span>Flickr Photo API</span>
        <span class="brand-badge">CASA0017</span>
      </a>
      <ul class="nav-links">
        <li><a href="/" class="nav-link">API Explorer</a></li>
        <li><a href="/examples/map" class="nav-link">Map Demo</a></li>
        <li><a href="/examples/cameras" class="nav-link">Top Cameras</a></li>
        <li><a href="/examples/photo/4279893539" class="nav-link active">Photo Lookup</a></li>
      </ul>
    </div>
  </nav>

  <main class="main-wrapper">

    <header class="page-intro">
      <div class="page-eyebrow">Interactive Example</div>
      <h1 class="page-title">Photo Metadata Lookup</h1>
      <p class="page-desc">
        Enter a Photo ID to query <code>GET /data/photoDescription/:pid</code> and compare the formatted record with the raw JSON response.
      </p>
    </header>

    <!-- Search Bar -->
    <div class="card" style="margin-bottom: 1.5rem;">
      <div class="card-body">
        <form onsubmit="event.preventDefault(); loadPhoto(document.getElementById('input-pid').value.trim());" style="display: flex; gap: 0.65rem; flex-wrap: wrap; align-items: center;">
          <input type="number" id="input-pid" class="form-input" value="<%= pid %>" placeholder="Enter Photo ID (e.g. 4279893539)" style="max-width: 280px;">
          <button type="submit" class="btn btn-primary">Lookup Photo</button>
          <div class="quick-pills" style="margin-top: 0; margin-left: 0.5rem;">
            <span class="pill-label">Samples:</span>
            <button type="button" class="quick-pill" onclick="setAndLoadPid(4279893539)">4279893539</button>
            <button type="button" class="quick-pill" onclick="setAndLoadPid(4338957434)">4338957434</button>
            <button type="button" class="quick-pill" onclick="setAndLoadPid(4256957563)">4256957563</button>
            <button type="button" class="quick-pill" onclick="setAndLoadPid(4322798589)">4322798589</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Two Column Result -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.5rem; align-items: start;">

      <!-- Left: Formatted Card -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">Parsed Photo Details</span>
          <span id="photo-status" style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--success); font-weight: 600;">Ready</span>
        </div>
        <div class="card-body" id="photo-card-body">
          <div style="color: var(--text-muted); padding: 1rem 0;">Loading photo...</div>
        </div>
      </div>

      <!-- Right: Raw JSON & Code -->
      <div class="response-card">
        <div class="url-bar">
          <span class="method-badge">GET</span>
          <div class="url-box" id="photo-url-box">/data/photoDescription/<%= pid %></div>
          <button type="button" class="btn btn-dark btn-sm" onclick="copyJson()">Copy JSON</button>
        </div>

        <div class="response-toolbar">
          <div class="dark-tabs">
            <button type="button" class="dark-tab active" onclick="switchTab(this, 'tab-json')">Raw JSON</button>
            <button type="button" class="dark-tab" onclick="switchTab(this, 'tab-code')">JavaScript Code</button>
          </div>
        </div>

        <div id="tab-json" class="dark-panel active">
          <pre class="json-pre" id="json-viewer">Loading...</pre>
        </div>

        <div id="tab-code" class="dark-panel">
          <pre class="code-block" id="code-viewer"></pre>
        </div>
      </div>

    </div>

  </main>

  <footer class="footer">
    <div class="footer-content">
      <div><strong>UCL Centre for Advanced Spatial Analysis (CASA)</strong> • CASA0017 Web Architecture</div>
      <div>Flickr Spatial &amp; Metadata API</div>
    </div>
  </footer>

  <script>
    let currentData = null;

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function setAndLoadPid(pid) {
      document.getElementById('input-pid').value = pid;
      loadPhoto(pid);
    }

    async function loadPhoto(pid) {
      if (!pid) return;

      const endpoint = `/data/photoDescription/${encodeURIComponent(pid)}`;
      document.getElementById('photo-url-box').textContent = endpoint;
      document.getElementById('code-viewer').textContent =
`fetch('${window.location.origin}${endpoint}')
  .then(res => res.json())
  .then(data => {
    if (data.length > 0) {
      const photo = data[0];
      const title = decodeURIComponent(photo.description.replace(/\\+/g, ' '));
      console.log(title, photo.device);
    }
  });`;

      const cardBody = document.getElementById('photo-card-body');
      const jsonViewer = document.getElementById('json-viewer');
      const statusEl = document.getElementById('photo-status');

      cardBody.innerHTML = '<div style="color: var(--text-muted);">Loading...</div>';
      jsonViewer.textContent = 'Loading...';
      statusEl.textContent = 'Fetching...';

      try {
        const res = await fetch(endpoint);
        currentData = await res.json();
        jsonViewer.textContent = JSON.stringify(currentData, null, 2);

        if (!res.ok || !Array.isArray(currentData) || currentData.length === 0) {
          statusEl.textContent = res.ok ? 'Not Found' : `HTTP ${res.status}`;
          cardBody.innerHTML = '<div style="color: var(--text-muted);">No metadata record found for this Photo ID.</div>';
          return;
        }

        statusEl.textContent = '200 OK';
        const photo = currentData[0];

        let decodedTitle = 'Untitled';
        try {
          decodedTitle = photo.description ? decodeURIComponent(photo.description.replace(/\+/g, ' ')) : 'Untitled';
        } catch {
          decodedTitle = photo.description || 'Untitled';
        }

        const tagsHtml = photo.tags
          ? photo.tags.split(',').filter(Boolean).map(t => `<span class="tag-chip">${escapeHtml(t.trim())}</span>`).join('')
          : '<span style="color: var(--text-muted); font-size: 0.84rem;">None</span>';

        const uploadDate = photo.date_uploaded
          ? new Date(Number(photo.date_uploaded) * 1000).toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })
          : 'Unknown';

        cardBody.innerHTML = `
          <div style="display: flex; flex-direction: column; gap: 1rem;">
            ${photo.download_url ? `
              <div style="background: var(--bg-code); border-radius: var(--radius-md); overflow: hidden; text-align: center;">
                <img src="${escapeHtml(photo.download_url)}" alt="${escapeHtml(decodedTitle)}" style="max-width: 100%; max-height: 260px; object-fit: contain;" onerror="this.parentElement.style.display='none'">
              </div>
            ` : ''}

            <div>
              <div style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted);">Photo ID: ${photo.pid}</div>
              <h2 style="font-size: 1.25rem; font-weight: 700; margin-top: 0.15rem;">${escapeHtml(decodedTitle)}</h2>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; background: var(--bg-page); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.85rem;">
              <div>
                <div style="font-size: 0.72rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Camera</div>
                <div style="font-weight: 600; color: var(--primary); font-size: 0.9rem; margin-top: 2px;">${escapeHtml(photo.device || 'Unknown')}</div>
              </div>
              <div>
                <div style="font-size: 0.72rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase;">Uploaded</div>
                <div style="font-weight: 600; font-size: 0.9rem; margin-top: 2px;">${uploadDate}</div>
              </div>
            </div>

            <div>
              <div style="font-size: 0.72rem; color: var(--text-muted); font-weight: 600; text-transform: uppercase; margin-bottom: 0.35rem;">Tags</div>
              <div>${tagsHtml}</div>
            </div>
          </div>
        `;
      } catch (err) {
        statusEl.textContent = 'Error';
        cardBody.innerHTML = `<div style="color: var(--danger);">Error: ${escapeHtml(err.message)}</div>`;
      }
    }

    function switchTab(btn, panelId) {
      document.querySelectorAll('.dark-tab').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.dark-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(panelId).classList.add('active');
    }

    function copyJson() {
      if (!currentData) return;
      navigator.clipboard.writeText(JSON.stringify(currentData, null, 2)).then(() => {
        showToast('JSON copied to clipboard');
      });
    }

    window.addEventListener('DOMContentLoaded', () => {
      loadPhoto(document.getElementById('input-pid').value.trim());
    });
  </script>
</body>
</html>
