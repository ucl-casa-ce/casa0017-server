  <!-- Interactive JavaScript for Try-It Console -->
  <script>
    function switchTab(btn, panelId) {
      const container = btn.closest('.response-container');
      container.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      container.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(panelId).classList.add('active');
    }

    function copySnippet(elementId) {
      const text = document.getElementById(elementId).innerText;
      navigator.clipboard.writeText(text).then(() => {
        alert('Copied to clipboard!');
      });
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // Endpoint 1: Spatial
    function setEndpoint1(lat, lon, r) {
      document.getElementById('ep1-lat').value = lat;
      document.getElementById('ep1-lon').value = lon;
      document.getElementById('ep1-radius').value = r;
      runEndpoint1();
    }

    async function runEndpoint1() {
      const lat = document.getElementById('ep1-lat').value;
      const lon = document.getElementById('ep1-lon').value;
      const r = document.getElementById('ep1-radius').value;
      const resContainer = document.getElementById('ep1-response');
      const preview = document.getElementById('ep1-preview-content');
      const jsonPre = document.getElementById('ep1-json');
      const codePre = document.getElementById('ep1-code');
      const meta = document.getElementById('ep1-meta');
      const badge = document.getElementById('ep1-status-badge');

      resContainer.style.display = 'block';
      preview.innerHTML = '<div style="color: var(--text-muted);">Querying database...</div>';
      jsonPre.innerText = 'Loading...';

      const url = `/data/${lat}/${lon}/${r}`;
      codePre.innerText = `// Fetch photo locations within ${r}km\nfetch('${url}')\n  .then(res => res.json())\n  .then(photos => {\n    console.log('Found photos:', photos.length);\n    photos.forEach(p => {\n      L.marker([p.lat, p.lon]).addTo(map);\n    });\n  });`;

      const start = performance.now();
      try {
        const res = await fetch(url);
        const data = await res.json();
        const duration = (performance.now() - start).toFixed(0);

        badge.className = `status-badge ${res.ok ? 'status-200' : 'status-400'}`;
        badge.innerText = `${res.status} ${res.statusText}`;
        meta.innerText = `${data.length ? data.length.toLocaleString() + ' records' : '0 records'} • ${duration}ms`;

        jsonPre.innerText = JSON.stringify(data.slice(0, 50), null, 2) + (data.length > 50 ? `\n\n// ... (${data.length - 50} more items)` : '');

        if (data.length === 0) {
          preview.innerHTML = '<div style="color: var(--text-muted);">No photos found in this radius.</div>';
        } else {
          preview.innerHTML = `
            <div style="font-size: 0.85rem; margin-bottom: 0.75rem; color: var(--text-muted);">
              Found <b>${data.length.toLocaleString()}</b> photos within ${r} km. Showing first 10:
            </div>
            <div class="params-table-wrapper" style="margin: 0;">
              <table class="params-table">
                <thead>
                  <tr>
                    <th>Photo ID</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  ${data.slice(0, 10).map(p => `
                    <tr>
                      <td><code>${p.pid}</code></td>
                      <td>${p.lat}</td>
                      <td>${p.lon}</td>
                      <td><a href="/examples/photo/${p.pid}" target="_blank" class="btn btn-secondary btn-sm">Inspect Details →</a></td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          `;
        }
      } catch (err) {
        badge.className = 'status-badge status-500';
        badge.innerText = 'Error';
        jsonPre.innerText = `{\n  "error": "${err.message}"\n}`;
        preview.innerHTML = `<div style="color: var(--danger);">Failed: ${err.message}</div>`;
      }
    }

    // Endpoint 2: Photo Metadata
    function setEndpoint2(pid) {
      document.getElementById('ep2-pid').value = pid;
      runEndpoint2();
    }

    async function runEndpoint2() {
      const pid = document.getElementById('ep2-pid').value;
      const resContainer = document.getElementById('ep2-response');
      const preview = document.getElementById('ep2-preview-content');
      const jsonPre = document.getElementById('ep2-json');
      const codePre = document.getElementById('ep2-code');
      const meta = document.getElementById('ep2-meta');
      const badge = document.getElementById('ep2-status-badge');

      resContainer.style.display = 'block';
      preview.innerHTML = '<div style="color: var(--text-muted);">Querying photo metadata...</div>';
      jsonPre.innerText = 'Loading...';

      const url = `/data/photoDescription/${pid}`;
      codePre.innerText = `// Fetch photo metadata\nfetch('${url}')\n  .then(res => res.json())\n  .then(data => {\n    if (data.length > 0) {\n      const photo = data[0];\n      console.log('Title:', photo.description);\n      console.log('Camera:', photo.device);\n    }\n  });`;

      const start = performance.now();
      try {
        const res = await fetch(url);
        const data = await res.json();
        const duration = (performance.now() - start).toFixed(0);

        badge.className = `status-badge ${res.ok ? 'status-200' : 'status-400'}`;
        badge.innerText = `${res.status} ${res.statusText}`;
        meta.innerText = `${duration}ms`;

        jsonPre.innerText = JSON.stringify(data, null, 2);

        if (!data || data.length === 0) {
          preview.innerHTML = '<div style="color: var(--text-muted);">No photo record found for this Photo ID.</div>';
        } else {
          const photo = data[0];
          let decodedTitle = photo.description ? decodeURIComponent(photo.description.replace(/\+/g, ' ')) : 'Untitled';
          let tagsList = photo.tags ? photo.tags.split(',').map(t => `<span class="tag-chip">${escapeHtml(t.trim())}</span>`).join('') : 'None';
          preview.innerHTML = `
            <div style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 1rem;">
              <div style="font-size: 0.75rem; color: var(--text-muted); font-weight: 700;">PHOTO ID: ${photo.pid}</div>
              <div style="font-size: 1.15rem; font-weight: 800; margin: 0.25rem 0 0.5rem 0;">${escapeHtml(decodedTitle)}</div>
              <div style="margin-bottom: 0.5rem;"><span class="record-badge">📷 ${escapeHtml(photo.device || 'Unknown Camera')}</span></div>
              <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.4rem;"><b>Tags:</b></div>
              <div class="record-tags">${tagsList}</div>
              <div style="margin-top: 1rem;">
                <a href="/examples/photo/${photo.pid}" class="btn btn-secondary btn-sm">Open Full Photo Inspector →</a>
              </div>
            </div>
          `;
        }
      } catch (err) {
        badge.className = 'status-badge status-500';
        badge.innerText = 'Error';
        jsonPre.innerText = `{\n  "error": "${err.message}"\n}`;
        preview.innerHTML = `<div style="color: var(--danger);">Failed: ${err.message}</div>`;
      }
    }

    // Endpoint 3: Top Camera
    async function runEndpoint3() {
      const resContainer = document.getElementById('ep3-response');
      const preview = document.getElementById('ep3-preview-content');
      const jsonPre = document.getElementById('ep3-json');
      const codePre = document.getElementById('ep3-code');
      const meta = document.getElementById('ep3-meta');
      const badge = document.getElementById('ep3-status-badge');

      resContainer.style.display = 'block';
      preview.innerHTML = '<div style="color: var(--text-muted);">Querying top cameras...</div>';
      jsonPre.innerText = 'Loading...';

      const url = '/data/topCamera';
      codePre.innerText = `// Fetch top 30 camera devices\nfetch('${url}')\n  .then(res => res.json())\n  .then(cameras => {\n    cameras.forEach(c => {\n      console.log(c.device + ': ' + c.count);\n    });\n  });`;

      const start = performance.now();
      try {
        const res = await fetch(url);
        const data = await res.json();
        const duration = (performance.now() - start).toFixed(0);

        badge.className = `status-badge ${res.ok ? 'status-200' : 'status-400'}`;
        badge.innerText = `${res.status} ${res.statusText}`;
        meta.innerText = `${data.length} cameras • ${duration}ms`;

        jsonPre.innerText = JSON.stringify(data, null, 2);

        const maxCount = data.length > 0 ? data[0].count : 1;
        preview.innerHTML = `
          <div class="camera-rank-list">
            ${data.slice(0, 10).map((c, i) => `
              <div class="camera-rank-item" onclick="setEndpoint4('${escapeHtml(c.device)}')">
                <div class="rank-number">#${i + 1}</div>
                <div class="rank-details">
                  <div class="rank-device">${escapeHtml(c.device)}</div>
                  <div class="rank-bar-bg">
                    <div class="rank-bar-fill" style="width: ${Math.round((c.count / maxCount) * 100)}%;"></div>
                  </div>
                </div>
                <div class="rank-count-badge">${Number(c.count).toLocaleString()}</div>
              </div>
            `).join('')}
          </div>
          <div style="margin-top: 1rem; text-align: center;">
            <a href="/examples/cameras" class="btn btn-secondary btn-sm">Explore All in Camera Explorer →</a>
          </div>
        `;
      } catch (err) {
        badge.className = 'status-badge status-500';
        badge.innerText = 'Error';
        jsonPre.innerText = `{\n  "error": "${err.message}"\n}`;
        preview.innerHTML = `<div style="color: var(--danger);">Failed: ${err.message}</div>`;
      }
    }

    // Endpoint 4: Filter by Camera
    function setEndpoint4(cam) {
      document.getElementById('ep4-camera').value = cam;
      runEndpoint4();
    }

    async function runEndpoint4() {
      const cam = document.getElementById('ep4-camera').value;
      const resContainer = document.getElementById('ep4-response');
      const preview = document.getElementById('ep4-preview-content');
      const jsonPre = document.getElementById('ep4-json');
      const codePre = document.getElementById('ep4-code');
      const meta = document.getElementById('ep4-meta');
      const badge = document.getElementById('ep4-status-badge');

      resContainer.style.display = 'block';
      preview.innerHTML = '<div style="color: var(--text-muted);">Querying photos by camera...</div>';
      jsonPre.innerText = 'Loading...';

      const url = `/data/cameraType/${encodeURIComponent(cam)}`;
      codePre.innerText = `// Search photos by camera\nfetch('${url}')\n  .then(res => res.json())\n  .then(photos => {\n    console.log('Photos taken with ${cam}:', photos.length);\n  });`;

      const start = performance.now();
      try {
        const res = await fetch(url);
        const data = await res.json();
        const duration = (performance.now() - start).toFixed(0);

        badge.className = `status-badge ${res.ok ? 'status-200' : 'status-400'}`;
        badge.innerText = `${res.status} ${res.statusText}`;
        meta.innerText = `${data.length ? data.length.toLocaleString() + ' photos' : '0 photos'} • ${duration}ms`;

        jsonPre.innerText = JSON.stringify(data.slice(0, 30), null, 2) + (data.length > 30 ? `\n\n// ... (${data.length - 30} more items)` : '');

        if (data.length === 0) {
          preview.innerHTML = '<div style="color: var(--text-muted);">No photos found for this camera model.</div>';
        } else {
          preview.innerHTML = `
            <div style="font-size: 0.85rem; margin-bottom: 0.75rem; color: var(--text-muted);">
              Found <b>${data.length.toLocaleString()}</b> photos taken with <b>${escapeHtml(cam)}</b>. Showing first 10:
            </div>
            <div class="params-table-wrapper" style="margin: 0;">
              <table class="params-table">
                <thead>
                  <tr>
                    <th>Photo ID</th>
                    <th>Latitude</th>
                    <th>Longitude</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  ${data.slice(0, 10).map(p => `
                    <tr>
                      <td><code>${p.pid}</code></td>
                      <td>${p.lat}</td>
                      <td>${p.lon}</td>
                      <td><a href="/examples/photo/${p.pid}" target="_blank" class="btn btn-secondary btn-sm">Inspect Details →</a></td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            </div>
          `;
        }
      } catch (err) {
        badge.className = 'status-badge status-500';
        badge.innerText = 'Error';
        jsonPre.innerText = `{\n  "error": "${err.message}"\n}`;
        preview.innerHTML = `<div style="color: var(--danger);">Failed: ${err.message}</div>`;
      }
    }
  </script>
</body>
</html>
