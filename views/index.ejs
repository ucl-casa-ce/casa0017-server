<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Flickr Photo API • CASA0017</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/modal.js"></script>
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <span>Flickr Photo API</span>
        <span class="brand-badge">CASA0017</span>
      </a>
      <ul class="nav-links">
        <li><a href="/" class="nav-link active">API Explorer</a></li>
        <li><a href="/examples/map" class="nav-link">Map Demo</a></li>
        <li><a href="/examples/cameras" class="nav-link">Top Cameras</a></li>
        <li><a href="/examples/photo/4279893539" class="nav-link">Photo Lookup</a></li>
      </ul>
    </div>
  </nav>

  <main class="main-wrapper" id="container">

    <!-- Simple Page Intro -->
    <header class="page-intro">
      <div class="page-eyebrow">UCL Connected Environments • CASA0017</div>
      <h1 class="page-title">Flickr Spatial &amp; Metadata API</h1>
      <p class="page-desc">
        Explore 37,517 geotagged UK Flickr photos from early 2010. Choose an endpoint below to test parameters, inspect the live JSON response, and copy starter JavaScript code.
      </p>
    </header>

    <!-- Main Interactive API Tester -->
    <section class="tester-grid">

      <!-- Left: Endpoint Selection & Parameters -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">1. Select an Endpoint</span>
          <a href="/examples/map" id="demo-link" class="btn btn-secondary btn-sm">Open Map Demo →</a>
        </div>
        <div class="card-body">

          <div class="endpoint-list">
            <button type="button" class="endpoint-item active" id="ep-btn-spatial" onclick="selectEndpoint('spatial')">
              <div class="endpoint-item-route">
                <span class="method-badge">GET</span>
                <span>/data/:lat/:lon/:radius</span>
              </div>
              <div class="endpoint-item-desc">Find photos within a radius (km) of a latitude/longitude point</div>
            </button>

            <button type="button" class="endpoint-item" id="ep-btn-photo" onclick="selectEndpoint('photo')">
              <div class="endpoint-item-route">
                <span class="method-badge">GET</span>
                <span>/data/photoDescription/:pid</span>
              </div>
              <div class="endpoint-item-desc">Get title, camera, tags, and image URL for a single photo ID</div>
            </button>

            <button type="button" class="endpoint-item" id="ep-btn-topcamera" onclick="selectEndpoint('topcamera')">
              <div class="endpoint-item-route">
                <span class="method-badge">GET</span>
                <span>/data/topCamera</span>
              </div>
              <div class="endpoint-item-desc">List the top 30 most popular camera models by photo count</div>
            </button>

            <button type="button" class="endpoint-item" id="ep-btn-cameratype" onclick="selectEndpoint('cameratype')">
              <div class="endpoint-item-route">
                <span class="method-badge">GET</span>
                <span>/data/cameraType/:camera</span>
              </div>
              <div class="endpoint-item-desc">Find photo locations taken with a matching camera model</div>
            </button>
          </div>

          <!-- Parameter Inputs: Spatial -->
          <div id="params-spatial" class="param-box">
            <div class="inputs-row">
              <div class="form-group">
                <label class="form-label" for="in-lat">Latitude</label>
                <input type="text" id="in-lat" class="form-input" value="51.5074" oninput="updateUrlPreview()">
              </div>
              <div class="form-group">
                <label class="form-label" for="in-lon">Longitude</label>
                <input type="text" id="in-lon" class="form-input" value="-0.1278" oninput="updateUrlPreview()">
              </div>
              <div class="form-group">
                <label class="form-label" for="in-radius">Radius (km)</label>
                <input type="text" id="in-radius" class="form-input" value="10" oninput="updateUrlPreview()">
              </div>
            </div>
            <div class="quick-pills">
              <span class="pill-label">Try:</span>
              <button type="button" class="quick-pill" onclick="setSpatial(51.5074, -0.1278, 10)">London (10 km)</button>
              <button type="button" class="quick-pill" onclick="setSpatial(53.4808, -2.2426, 15)">Manchester (15 km)</button>
              <button type="button" class="quick-pill" onclick="setSpatial(55.9533, -3.1883, 15)">Edinburgh (15 km)</button>
              <button type="button" class="quick-pill" onclick="setSpatial(51.514756, -0.104345, 1000000000000)">All Photos</button>
            </div>
          </div>

          <!-- Parameter Inputs: Photo Description -->
          <div id="params-photo" class="param-box" style="display: none;">
            <div class="form-group">
              <label class="form-label" for="in-pid">Photo ID (pid)</label>
              <input type="text" id="in-pid" class="form-input" value="4279893539" oninput="updateUrlPreview()">
            </div>
            <div class="quick-pills">
              <span class="pill-label">Samples:</span>
              <button type="button" class="quick-pill" onclick="setPhoto('4279893539')">4279893539</button>
              <button type="button" class="quick-pill" onclick="setPhoto('4338957434')">4338957434</button>
              <button type="button" class="quick-pill" onclick="setPhoto('4256957563')">4256957563</button>
              <button type="button" class="quick-pill" onclick="setPhoto('4322798589')">4322798589</button>
            </div>
          </div>

          <!-- Parameter Inputs: Top Camera -->
          <div id="params-topcamera" class="param-box" style="display: none;">
            <div style="font-size: 0.84rem; color: var(--text-muted);">
              No parameters needed. Click <strong>Send Request</strong> to fetch the 30 most common cameras in the dataset.
            </div>
          </div>

          <!-- Parameter Inputs: Camera Type -->
          <div id="params-cameratype" class="param-box" style="display: none;">
            <div class="form-group">
              <label class="form-label" for="in-camera">Camera Brand or Model</label>
              <input type="text" id="in-camera" class="form-input" value="Canon" oninput="updateUrlPreview()">
            </div>
            <div class="quick-pills">
              <span class="pill-label">Try:</span>
              <button type="button" class="quick-pill" onclick="setCamera('Canon')">Canon</button>
              <button type="button" class="quick-pill" onclick="setCamera('Nikon')">Nikon</button>
              <button type="button" class="quick-pill" onclick="setCamera('Apple')">Apple</button>
              <button type="button" class="quick-pill" onclick="setCamera('Sony')">Sony</button>
            </div>
          </div>

          <button type="button" class="btn btn-primary" id="send-btn" onclick="sendRequest()" style="width: 100%;">
            Send Request
          </button>
        </div>
      </div>

      <!-- Right: Live URL, Response & Starter Code -->
      <div class="response-card">
        <div class="url-bar">
          <span class="method-badge">GET</span>
          <div class="url-box" id="url-display">/data/51.5074/-0.1278/10</div>
          <button type="button" class="btn btn-dark btn-sm" onclick="copyCurrentUrl()">Copy URL</button>
          <a href="/data/51.5074/-0.1278/10" target="_blank" id="raw-link" class="btn btn-dark btn-sm">Open Raw ↗</a>
        </div>

        <div class="response-toolbar">
          <div class="dark-tabs">
            <button type="button" class="dark-tab active" onclick="switchResponseTab(this, 'tab-json')">JSON Response</button>
            <button type="button" class="dark-tab" onclick="switchResponseTab(this, 'tab-preview')">Table Preview</button>
            <button type="button" class="dark-tab" onclick="switchResponseTab(this, 'tab-code')">JavaScript Code</button>
          </div>
          <div style="display: flex; align-items: center; gap: 0.65rem;">
            <span id="status-badge" class="status-badge status-200">200 OK</span>
            <span id="response-meta" style="font-family: var(--font-mono); font-size: 0.76rem; color: #94a3b8;"></span>
            <button type="button" class="btn btn-dark btn-sm" onclick="copyJsonOutput()">Copy JSON</button>
          </div>
        </div>

        <!-- Tab 1: Raw JSON -->
        <div id="tab-json" class="dark-panel active">
          <pre id="json-output" class="json-pre">Loading...</pre>
        </div>

        <!-- Tab 2: Clean Table Preview -->
        <div id="tab-preview" class="dark-panel">
          <div id="preview-output"></div>
        </div>

        <!-- Tab 3: Starter Code -->
        <div id="tab-code" class="dark-panel">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <span style="font-size: 0.78rem; color: #94a3b8;">Copy-ready client code for your coursework:</span>
            <button type="button" class="btn btn-dark btn-sm" onclick="copyCodeOutput()">Copy Code</button>
          </div>
          <pre id="code-output" class="code-block"></pre>
        </div>
      </div>

    </section>

    <!-- Bottom Reference & Downloads -->
    <section class="info-grid">

      <!-- Left: Response Fields & Useful Tips -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">API Response Fields &amp; Student Notes</span>
        </div>
        <div class="card-body">
          <table class="simple-table">
            <thead>
              <tr>
                <th>Field</th>
                <th>Endpoint</th>
                <th>Description &amp; Usage Note</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>pid</code></td>
                <td>Location &amp; Photo</td>
                <td>Unique Flickr Photo ID used to join locations with metadata.</td>
              </tr>
              <tr>
                <td><code>lat</code>, <code>lon</code></td>
                <td>Location &amp; Camera</td>
                <td>WGS84 decimal coordinates for plotting Leaflet markers.</td>
              </tr>
              <tr>
                <td><code>description</code></td>
                <td>Photo Description</td>
                <td>URL-encoded title (spaces are <code>+</code>). Decode with <code>decodeURIComponent(str.replace(/\+/g, ' '))</code>.</td>
              </tr>
              <tr>
                <td><code>device</code></td>
                <td>Photo &amp; Cameras</td>
                <td>EXIF camera model string (e.g. <code>Canon EOS 40D</code>).</td>
              </tr>
              <tr>
                <td><code>date_uploaded</code></td>
                <td>Photo Description</td>
                <td>Unix timestamp in seconds. Multiply by <code>1000</code> for JS <code>new Date(ts * 1000)</code>.</td>
              </tr>
              <tr>
                <td><code>download_url</code></td>
                <td>Photo Description</td>
                <td>Static Flickr image URL. Note: <code>/data/photoDescription/:pid</code> returns a 1-item array <code>[ { ... } ]</code>.</td>
              </tr>
            </tbody>
          </table>

          <div style="margin-top: 1rem; padding: 0.75rem 0.9rem; background: var(--bg-page); border: 1px solid var(--border-color); border-radius: var(--radius-md); font-size: 0.82rem; color: var(--text-secondary);">
            <strong>Full Dataset Tip:</strong> Using a very large radius (e.g. <code>1000000000000</code> km) from London returns all 37,517 photos at once:<br>
            <code style="font-size: 0.76rem; word-break: break-all;">https://casa0017.cetools.org/data/51.514756/-0.104345/1000000000000</code>
          </div>
        </div>
      </div>

      <!-- Right: Raw Dataset Downloads -->
      <div class="card">
        <div class="card-header">
          <span class="card-title">Download Raw Datasets</span>
        </div>
        <div class="card-body">
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
            Download the underlying CSV tables and SQL dumps for offline analysis or local MySQL import:
          </p>
          <div class="download-list">
            <div class="download-row">
              <div>
                <div style="font-weight: 600; font-size: 0.88rem;">Photo Locations CSV</div>
                <div style="font-size: 0.76rem; color: var(--text-muted);">37,517 rows • pid, lat, lon (~2.9 MB)</div>
              </div>
              <a href="/download/flickr_2010_uk_JanFeb_photo_locations.csv" download class="btn btn-secondary btn-sm">Download</a>
            </div>

            <div class="download-row">
              <div>
                <div style="font-weight: 600; font-size: 0.88rem;">Photos Metadata CSV</div>
                <div style="font-size: 0.76rem; color: var(--text-muted);">37,517 rows • pid, date_uploaded, download_url (~3.1 MB)</div>
              </div>
              <a href="/download/flickr_2010_uk_JanFeb_photos.csv" download class="btn btn-secondary btn-sm">Download</a>
            </div>

            <div class="download-row">
              <div>
                <div style="font-weight: 600; font-size: 0.88rem;">Cities Reference SQL</div>
                <div style="font-size: 0.76rem; color: var(--text-muted);">cities.sql • Reference city coordinates (~2.3 MB)</div>
              </div>
              <a href="/download/cities.sql" download class="btn btn-secondary btn-sm">Download</a>
            </div>

            <div class="download-row" style="background: var(--primary-light); border-color: var(--primary-border);">
              <div>
                <div style="font-weight: 600; font-size: 0.88rem; color: var(--primary);">Complete Archive (.zip)</div>
                <div style="font-size: 0.76rem; color: var(--text-secondary);">All CSV datasets and SQL schemas (~1.3 MB)</div>
              </div>
              <a href="/download/data.zip" download class="btn btn-primary btn-sm">Download ZIP</a>
            </div>
          </div>
        </div>
      </div>

    </section>

  </main>

  <footer class="footer">
    <div class="footer-content">
      <div><strong>UCL Centre for Advanced Spatial Analysis (CASA)</strong> • CASA0017 Web Architecture</div>
      <div>Flickr Spatial &amp; Metadata API</div>
    </div>
  </footer>

  <script>
    let currentEndpoint = 'spatial';
    let lastRawJson = '';

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function highlightJson(jsonStr) {
      return escapeHtml(jsonStr).replace(
        /("(\\u[a-zA-Z0-9]{4}|\\[^u]|[^\\"])*"(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d*)?(?:[eE][+\-]?\d+)?)/g,
        function (match) {
          let cls = 'json-number';
          if (/^"/.test(match)) {
            cls = /:$/.test(match) ? 'json-key' : 'json-string';
          } else if (/true|false/.test(match)) {
            cls = 'json-boolean';
          } else if (/null/.test(match)) {
            cls = 'json-null';
          }
          return '<span class="' + cls + '">' + match + '</span>';
        }
      );
    }

    function getPath() {
      if (currentEndpoint === 'spatial') {
        const lat = document.getElementById('in-lat').value.trim() || '0';
        const lon = document.getElementById('in-lon').value.trim() || '0';
        const r = document.getElementById('in-radius').value.trim() || '0';
        return `/data/${encodeURIComponent(lat)}/${encodeURIComponent(lon)}/${encodeURIComponent(r)}`;
      }
      if (currentEndpoint === 'photo') {
        const pid = document.getElementById('in-pid').value.trim() || '0';
        return `/data/photoDescription/${encodeURIComponent(pid)}`;
      }
      if (currentEndpoint === 'topcamera') {
        return `/data/topCamera`;
      }
      if (currentEndpoint === 'cameratype') {
        const cam = document.getElementById('in-camera').value.trim() || 'Canon';
        return `/data/cameraType/${encodeURIComponent(cam)}`;
      }
      return '/data/topCamera';
    }

    function selectEndpoint(ep) {
      currentEndpoint = ep;
      document.querySelectorAll('.endpoint-item').forEach(b => b.classList.remove('active'));
      document.getElementById('ep-btn-' + ep).classList.add('active');

      ['spatial', 'photo', 'topcamera', 'cameratype'].forEach(k => {
        document.getElementById('params-' + k).style.display = (k === ep) ? 'block' : 'none';
      });

      const demoLink = document.getElementById('demo-link');
      if (ep === 'spatial') {
        demoLink.href = '/examples/map';
        demoLink.textContent = 'Open Map Demo →';
      } else if (ep === 'photo') {
        const pid = document.getElementById('in-pid').value.trim() || '4279893539';
        demoLink.href = '/examples/photo/' + encodeURIComponent(pid);
        demoLink.textContent = 'Open Photo Lookup →';
      } else {
        demoLink.href = '/examples/cameras';
        demoLink.textContent = 'Open Camera Demo →';
      }

      updateUrlPreview();
      sendRequest();
    }

    function updateUrlPreview() {
      const path = getPath();
      document.getElementById('url-display').textContent = path;
      document.getElementById('raw-link').href = path;
      if (currentEndpoint === 'photo') {
        const pid = document.getElementById('in-pid').value.trim() || '4279893539';
        document.getElementById('demo-link').href = '/examples/photo/' + encodeURIComponent(pid);
      }
      updateCodeSnippet(path);
    }

    function updateCodeSnippet(path) {
      const fullUrl = window.location.origin + path;
      document.getElementById('code-output').textContent =
`// 1. Using modern JavaScript fetch()
fetch('${fullUrl}')
  .then(response => response.json())
  .then(data => {
    console.log('Result count:', data.length);
    console.log('First item:', data[0]);
  })
  .catch(err => console.error('API Error:', err));

// 2. Using jQuery $.getJSON() (Workshops 8 & 9)
$.getJSON('${fullUrl}', function(data) {
  console.log('Loaded ' + data.length + ' items');
  $.each(data, function(i, item) {
    // Process each record here
  });
});`;
    }

    function setSpatial(lat, lon, r) {
      document.getElementById('in-lat').value = lat;
      document.getElementById('in-lon').value = lon;
      document.getElementById('in-radius').value = r;
      updateUrlPreview();
      sendRequest();
    }

    function setPhoto(pid) {
      document.getElementById('in-pid').value = pid;
      updateUrlPreview();
      sendRequest();
    }

    function setCamera(cam) {
      document.getElementById('in-camera').value = cam;
      updateUrlPreview();
      sendRequest();
    }

    async function sendRequest() {
      const path = getPath();
      const jsonOut = document.getElementById('json-output');
      const statusBadge = document.getElementById('status-badge');
      const meta = document.getElementById('response-meta');
      const btn = document.getElementById('send-btn');

      btn.disabled = true;
      jsonOut.textContent = 'Fetching...';
      meta.textContent = '';

      const t0 = performance.now();
      try {
        const res = await fetch(path);
        const data = await res.json();
        const ms = Math.round(performance.now() - t0);

        statusBadge.className = 'status-badge ' + (res.ok ? 'status-200' : 'status-400');
        statusBadge.textContent = `${res.status} ${res.ok ? 'OK' : 'Error'}`;

        const countText = Array.isArray(data) ? `${data.length.toLocaleString()} items` : 'Object';
        meta.textContent = `${countText} • ${ms} ms`;

        lastRawJson = JSON.stringify(data, null, 2);

        if (Array.isArray(data) && data.length > 50) {
          const preview = JSON.stringify(data.slice(0, 50), null, 2);
          jsonOut.innerHTML = highlightJson(preview) + `\n<span class="json-null">// ... ${ (data.length - 50).toLocaleString() } more items (Copy JSON copies full response)</span>`;
        } else {
          jsonOut.innerHTML = highlightJson(lastRawJson);
        }

        renderPreview(data, res.ok);
      } catch (err) {
        statusBadge.className = 'status-badge status-500';
        statusBadge.textContent = 'Error';
        jsonOut.textContent = JSON.stringify({ error: err.message }, null, 2);
      } finally {
        btn.disabled = false;
      }
    }

    function renderPreview(data, isOk) {
      const box = document.getElementById('preview-output');
      if (!isOk || !Array.isArray(data) || data.length === 0) {
        box.innerHTML = `<div style="color: #94a3b8; font-size: 0.85rem;">No records to preview.</div>`;
        return;
      }

      if (currentEndpoint === 'spatial' || currentEndpoint === 'cameratype') {
        const rows = data.slice(0, 12);
        box.innerHTML = `
          <div style="font-size: 0.8rem; color: #94a3b8; margin-bottom: 0.6rem;">
            Showing first ${rows.length} of ${data.length.toLocaleString()} photos. Click a photo ID to inspect its metadata:
          </div>
          <table class="simple-table" style="color: #e2e8f0;">
            <thead>
              <tr>
                <th style="color: #94a3b8; border-color: #334155;">Photo ID (pid)</th>
                <th style="color: #94a3b8; border-color: #334155;">Latitude</th>
                <th style="color: #94a3b8; border-color: #334155;">Longitude</th>
                <th style="color: #94a3b8; border-color: #334155;">Action</th>
              </tr>
            </thead>
            <tbody>
              ${rows.map(r => `
                <tr>
                  <td style="color: #7dd3fc; border-color: #1e293b; font-family: var(--font-mono);">${r.pid}</td>
                  <td style="color: #cbd5e1; border-color: #1e293b; font-family: var(--font-mono);">${r.lat}</td>
                  <td style="color: #cbd5e1; border-color: #1e293b; font-family: var(--font-mono);">${r.lon}</td>
                  <td style="border-color: #1e293b;">
                    <button type="button" class="btn btn-dark btn-sm" onclick="selectEndpoint('photo'); setPhoto('${r.pid}');">Inspect Photo →</button>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      } else if (currentEndpoint === 'topcamera') {
        box.innerHTML = `
          <table class="simple-table" style="color: #e2e8f0;">
            <thead>
              <tr>
                <th style="color: #94a3b8; border-color: #334155;">#</th>
                <th style="color: #94a3b8; border-color: #334155;">Camera Model (device)</th>
                <th style="color: #94a3b8; border-color: #334155;">Count</th>
                <th style="color: #94a3b8; border-color: #334155;">Action</th>
              </tr>
            </thead>
            <tbody>
              ${data.slice(0, 12).map((c, i) => `
                <tr>
                  <td style="color: #64748b; border-color: #1e293b;">${i + 1}</td>
                  <td style="color: #86efac; border-color: #1e293b; font-weight: 600;">${escapeHtml(c.device)}</td>
                  <td style="color: #fcd34d; border-color: #1e293b; font-family: var(--font-mono);">${Number(c.count).toLocaleString()}</td>
                  <td style="border-color: #1e293b;">
                    <button type="button" class="btn btn-dark btn-sm" onclick="selectEndpoint('cameratype'); setCamera('${escapeHtml(c.device)}');">Find Photos →</button>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      } else if (currentEndpoint === 'photo') {
        const p = data[0];
        let title = p.description || 'Untitled';
        try { title = decodeURIComponent(p.description.replace(/\+/g, ' ')); } catch {}
        box.innerHTML = `
          <div style="display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.85rem;">
            <div><span style="color: #94a3b8;">Photo ID:</span> <strong style="color: #7dd3fc;">${p.pid}</strong></div>
            <div><span style="color: #94a3b8;">Decoded Title:</span> <strong style="color: #ffffff;">${escapeHtml(title)}</strong></div>
            <div><span style="color: #94a3b8;">Camera:</span> <strong style="color: #86efac;">${escapeHtml(p.device || 'Unknown')}</strong></div>
            <div><span style="color: #94a3b8;">Tags:</span> <span style="color: #cbd5e1;">${escapeHtml(p.tags || 'None')}</span></div>
            <div style="margin-top: 0.4rem;">
              <a href="/examples/photo/${p.pid}" class="btn btn-primary btn-sm">Open in Photo Lookup →</a>
            </div>
          </div>
        `;
      }
    }

    function switchResponseTab(btn, panelId) {
      document.querySelectorAll('.dark-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.dark-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(panelId).classList.add('active');
    }

    function copyCurrentUrl() {
      navigator.clipboard.writeText(window.location.origin + getPath()).then(() => {
        showToast('URL copied to clipboard');
      });
    }

    function copyJsonOutput() {
      if (!lastRawJson) return;
      navigator.clipboard.writeText(lastRawJson).then(() => {
        showToast('JSON copied to clipboard');
      });
    }

    function copyCodeOutput() {
      navigator.clipboard.writeText(document.getElementById('code-output').textContent).then(() => {
        showToast('Code copied to clipboard');
      });
    }

    window.addEventListener('DOMContentLoaded', () => {
      updateUrlPreview();
      sendRequest();
    });
  </script>
</body>
</html>
