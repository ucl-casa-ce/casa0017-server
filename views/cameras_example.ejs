<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Top Cameras • Flickr Photo API</title>
  <link rel="stylesheet" href="/css/style.css">
  <script src="/js/modal.js"></script>
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <span>Flickr Photo API</span>
        <span class="brand-badge">CASA0017</span>
      </a>
      <ul class="nav-links">
        <li><a href="/" class="nav-link">API Explorer</a></li>
        <li><a href="/examples/map" class="nav-link">Map Demo</a></li>
        <li><a href="/examples/cameras" class="nav-link active">Top Cameras</a></li>
        <li><a href="/examples/photo/4279893539" class="nav-link">Photo Lookup</a></li>
      </ul>
    </div>
  </nav>

  <main class="main-wrapper">

    <header class="page-intro">
      <div class="page-eyebrow">Interactive Example</div>
      <h1 class="page-title">Top Camera Models</h1>
      <p class="page-desc">
        Left: top 30 cameras from <code>GET /data/topCamera</code>. Click any camera model to query matching photos using <code>GET /data/cameraType/:camera</code>.
      </p>
    </header>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.5rem; align-items: start;">

      <!-- Left: Top 30 Cameras -->
      <div class="card">
        <div class="card-header">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span class="method-badge">GET</span>
            <span class="card-title">/data/topCamera</span>
          </div>
          <span id="total-cameras-badge" style="font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono);">Loading...</span>
        </div>
        <div class="card-body">
          <div class="form-group" style="margin-bottom: 0.9rem;">
            <input type="text" id="camera-filter-input" class="form-input" placeholder="Filter camera list..." oninput="filterCameras(this.value)">
          </div>

          <div id="camera-list-container" class="camera-rank-list" style="max-height: 540px; overflow-y: auto;">
            <div style="color: var(--text-muted); padding: 1rem;">Loading cameras...</div>
          </div>
        </div>
      </div>

      <!-- Right: Photos for Selected Camera -->
      <div class="card">
        <div class="card-header">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span class="method-badge">GET</span>
            <span class="card-title" id="selected-camera-title">/data/cameraType/:camera</span>
          </div>
          <span id="selected-camera-count" style="font-size: 0.78rem; color: var(--primary); font-family: var(--font-mono); font-weight: 600;"></span>
        </div>
        <div class="card-body">
          <div id="camera-photos-status" style="font-size: 0.84rem; color: var(--text-muted); margin-bottom: 0.9rem;">
            Select a camera on the left to load its photos.
          </div>

          <div id="camera-photos-container" style="max-height: 540px; overflow-y: auto;"></div>
        </div>
      </div>

    </div>

  </main>

  <footer class="footer">
    <div class="footer-content">
      <div><strong>UCL Centre for Advanced Spatial Analysis (CASA)</strong> • CASA0017 Web Architecture</div>
      <div>Flickr Spatial &amp; Metadata API</div>
    </div>
  </footer>

  <script>
    let topCamerasData = [];
    let selectedDevice = '';

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    async function loadTopCameras() {
      try {
        const res = await fetch('/data/topCamera');
        topCamerasData = await res.json();
        document.getElementById('total-cameras-badge').textContent = `${topCamerasData.length} models`;
        if (topCamerasData.length > 0) {
          selectedDevice = topCamerasData[0].device;
          renderCameraList(topCamerasData);
          selectCamera(selectedDevice);
        }
      } catch (err) {
        document.getElementById('camera-list-container').innerHTML =
          `<div style="color: var(--danger);">${escapeHtml(err.message)}</div>`;
      }
    }

    function renderCameraList(list) {
      const container = document.getElementById('camera-list-container');
      if (!list || list.length === 0) {
        container.innerHTML = '<div style="color: var(--text-muted); padding: 0.5rem;">No matching cameras.</div>';
        return;
      }

      const maxCount = topCamerasData.length > 0 ? topCamerasData[0].count : 1;

      container.innerHTML = list.map((item, index) => {
        const pct = Math.round((item.count / maxCount) * 100);
        const isActive = item.device === selectedDevice ? 'active' : '';
        return `
          <div class="camera-rank-item ${isActive}" onclick="selectCamera('${escapeHtml(item.device)}')">
            <div class="rank-number">#${index + 1}</div>
            <div class="rank-details">
              <div class="rank-device">${escapeHtml(item.device)}</div>
              <div class="rank-bar-bg">
                <div class="rank-bar-fill" style="width: ${pct}%;"></div>
              </div>
            </div>
            <div class="rank-count-badge">${Number(item.count).toLocaleString()}</div>
          </div>
        `;
      }).join('');
    }

    function filterCameras(query) {
      const q = query.toLowerCase().trim();
      const filtered = topCamerasData.filter(c => c.device.toLowerCase().includes(q));
      renderCameraList(filtered);
    }

    async function selectCamera(cameraName) {
      selectedDevice = cameraName;
      filterCameras(document.getElementById('camera-filter-input').value);

      const endpoint = `/data/cameraType/${encodeURIComponent(cameraName)}`;
      document.getElementById('selected-camera-title').textContent = endpoint;
      const countBadge = document.getElementById('selected-camera-count');
      const statusDiv = document.getElementById('camera-photos-status');
      const container = document.getElementById('camera-photos-container');

      countBadge.textContent = 'Loading...';
      statusDiv.innerHTML = `Fetching <code>GET ${escapeHtml(endpoint)}</code>...`;
      container.innerHTML = '';

      try {
        const res = await fetch(endpoint);
        const photos = await res.json();

        countBadge.textContent = `${photos.length.toLocaleString()} photos`;
        statusDiv.innerHTML = `Showing first ${Math.min(40, photos.length)} of <strong>${photos.length.toLocaleString()}</strong> photos taken with <strong>${escapeHtml(cameraName)}</strong>:`;

        if (photos.length === 0) {
          container.innerHTML = '<div style="color: var(--text-muted);">No photos found.</div>';
          return;
        }

        container.innerHTML = `
          <table class="simple-table">
            <thead>
              <tr>
                <th>Photo ID</th>
                <th>Coordinates</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              ${photos.slice(0, 40).map(p => `
                <tr>
                  <td><code>${p.pid}</code></td>
                  <td style="font-family: var(--font-mono); font-size: 0.8rem;">${p.lat}, ${p.lon}</td>
                  <td style="text-align: right;">
                    <a href="/examples/photo/${p.pid}" class="btn btn-secondary btn-sm">Lookup →</a>
                  </td>
                </tr>
              `).join('')}
            </tbody>
          </table>
        `;
      } catch (err) {
        statusDiv.innerHTML = `<span style="color: var(--danger);">Error: ${escapeHtml(err.message)}</span>`;
      }
    }

    window.addEventListener('DOMContentLoaded', loadTopCameras);
  </script>
</body>
</html>
