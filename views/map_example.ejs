<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Live Map Explorer • CASA0017 Flickr API</title>
  <link rel="stylesheet" href="/css/style.css">
  <!-- Leaflet CDN -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script src="/js/modal.js"></script>
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <span>📸 Flickr DB API</span>
        <span class="brand-badge">CASA0017</span>
      </a>
      <ul class="nav-links">
        <li><a href="/" class="nav-link">📖 Documentation</a></li>
        <li><a href="/examples/map" class="nav-link active">🗺️ Live Map</a></li>
        <li><a href="/examples/cameras" class="nav-link">📷 Top Cameras</a></li>
        <li><a href="/examples/photo/4279893539" class="nav-link">🔍 Photo Inspector</a></li>
        <li><a href="/#downloads" class="nav-link">💾 Datasets</a></li>
      </ul>
    </div>
  </nav>

  <div class="main-wrapper" style="padding-bottom: 2rem;">
    <!-- Header -->
    <div class="section-header" style="margin-bottom: 1.25rem;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h1 class="section-title">🗺️ Spatial Radius Query Visualizer</h1>
          <p class="section-desc">Interactive demonstration of <code>GET /data/:lat/:lon/:radius</code> and <code>GET /data/photoDescription/:pid</code> for Workshop 8 & 9.</p>
        </div>
        <a href="/" class="btn btn-secondary btn-sm">← Back to API Docs</a>
      </div>
    </div>

    <!-- Map Layout -->
    <div class="map-layout">
      <!-- Controls Panel -->
      <div class="map-controls-panel">
        <div>
          <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 0.25rem;">Search Parameters</h3>
          <p style="font-size: 0.8rem; color: var(--text-muted);">Click anywhere on the map or type coordinates below to search for photos.</p>
        </div>

        <!-- Presets -->
        <div class="form-group">
          <label class="form-label">City Presets</label>
          <div class="quick-pills" style="margin-bottom: 0;">
            <button type="button" class="quick-pill" onclick="setCoordinates(51.5074, -0.1278, 10)">London</button>
            <button type="button" class="quick-pill" onclick="setCoordinates(53.4808, -2.2426, 15)">Manchester</button>
            <button type="button" class="quick-pill" onclick="setCoordinates(55.9533, -3.1883, 15)">Edinburgh</button>
            <button type="button" class="quick-pill" onclick="setCoordinates(51.4545, -2.5879, 15)">Bristol</button>
            <button type="button" class="quick-pill" onclick="setCoordinates(51.514756, -0.104345, 1000)" style="background: var(--primary-light); color: var(--primary); font-weight: 700;">🌐 All UK</button>
          </div>
        </div>

        <!-- Lat / Lon -->
        <div class="form-group">
          <label class="form-label" for="map-lat">Latitude (WGS84)</label>
          <input type="number" step="any" id="map-lat" class="form-input" value="51.5074">
        </div>

        <div class="form-group">
          <label class="form-label" for="map-lon">Longitude (WGS84)</label>
          <input type="number" step="any" id="map-lon" class="form-input" value="-0.1278">
        </div>

        <!-- Radius Slider -->
        <div class="form-group">
          <div style="display: flex; justify-content: space-between;">
            <label class="form-label" for="map-radius">Radius (Kilometers)</label>
            <span id="radius-val" style="font-weight: 700; font-size: 0.85rem; color: var(--primary);">10 km</span>
          </div>
          <input type="range" id="map-radius" min="1" max="50" value="10" style="width: 100%; cursor: pointer;" oninput="updateRadius(this.value)">
        </div>

        <!-- Fetch Button -->
        <button type="button" class="btn btn-primary" id="fetch-btn" onclick="fetchPhotos()" style="width: 100%;">
          <span>🔍 Query Photos</span>
        </button>

        <!-- Status / Stats -->
        <div id="query-stats" style="background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-sm); padding: 0.85rem; font-size: 0.85rem;">
          <div style="font-weight: 600; margin-bottom: 0.25rem;">Query Status:</div>
          <div id="stats-text" style="color: var(--text-muted);">Ready to query. Click button or map.</div>
          <div id="api-call-url" style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--primary); margin-top: 0.5rem; word-break: break-all;"></div>
        </div>

        <!-- Code Snippet Hint for Students -->
        <div class="coursework-box" style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-color); font-size: 0.8rem; color: var(--text-muted);">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <b>💡 How to do this in your coursework:</b>
          </div>

          <div style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius-sm); overflow: hidden;">
            <div class="response-tabs" style="background: #f8fafc; border-bottom: 1px solid var(--border-color);">
              <button type="button" class="tab-btn active" style="padding: 0.4rem 0.75rem; font-size: 0.75rem;" onclick="switchCodeTab(this, 'tab-code-js')">Browser (fetch)</button>
              <button type="button" class="tab-btn" style="padding: 0.4rem 0.75rem; font-size: 0.75rem;" onclick="switchCodeTab(this, 'tab-code-node')">Node.js</button>
              <button type="button" class="tab-btn" style="padding: 0.4rem 0.75rem; font-size: 0.75rem;" onclick="switchCodeTab(this, 'tab-code-jquery')">jQuery</button>
            </div>

            <div id="tab-code-js" class="tab-panel active" style="padding: 0;">
              <pre class="code-block" style="margin: 0; padding: 0.6rem; font-size: 0.75rem; border-radius: 0; max-height: 180px; overflow-y: auto;">// Browser fetch + Leaflet
const lat = 51.5074, lon = -0.1278, radius = 10;

fetch(`/data/${lat}/${lon}/${radius}`)
  .then(res => res.json())
  .then(photos => {
    photos.forEach(p => {
      L.marker([p.lat, p.lon])
        .bindPopup(`Photo ID: ${p.pid}`)
        .addTo(map);
    });
  })
  .catch(err => console.error('Fetch error:', err));</pre>
            </div>

            <div id="tab-code-node" class="tab-panel" style="padding: 0;">
              <pre class="code-block" style="margin: 0; padding: 0.6rem; font-size: 0.75rem; border-radius: 0; max-height: 180px; overflow-y: auto;">// Node.js (v18+ native fetch)
async function fetchPhotos(lat, lon, radius) {
  const url = `http://localhost:3000/data/${lat}/${lon}/${radius}`;
  try {
    const res = await fetch(url);
    const photos = await res.json();
    console.log(`Retrieved ${photos.length} photos`);
    return photos;
  } catch (err) {
    console.error('Node fetch error:', err.message);
  }
}

fetchPhotos(51.5074, -0.1278, 10);</pre>
            </div>

            <div id="tab-code-jquery" class="tab-panel" style="padding: 0;">
              <pre class="code-block" style="margin: 0; padding: 0.6rem; font-size: 0.75rem; border-radius: 0; max-height: 180px; overflow-y: auto;">// jQuery getJSON (Workshop 8-9)
var lat = 51.5074, lon = -0.1278, radius = 10;

$.getJSON('/data/' + lat + '/' + lon + '/' + radius, function(photos) {
  $.each(photos, function(i, p) {
    L.marker([p.lat, p.lon])
      .bindPopup('Photo ID: ' + p.pid)
      .addTo(map);
  });
});</pre>
            </div>
          </div>
        </div>
      </div>

      <!-- Map Display Panel -->
      <div class="map-view-panel">
        <div id="map-container"></div>
      </div>
    </div>
  </div>

  <footer class="footer">
    <div class="footer-content">
      <div>UCL Centre for Advanced Spatial Analysis (CASA) • CASA0017 Web Architecture</div>
      <div>Flickr Geotagged Database API Explorer</div>
    </div>
  </footer>

  <script>
    let map, searchCircle;
    let markersLayer = L.layerGroup();

    // Initialize Leaflet Map centered on London
    function initMap() {
      map = L.map('map-container').setView([51.5074, -0.1278], 11);

      // OpenStreetMap Tiles
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(map);

      markersLayer.addTo(map);

      // Click on map to update coordinates
      map.on('click', function(e) {
        document.getElementById('map-lat').value = e.latlng.lat.toFixed(6);
        document.getElementById('map-lon').value = e.latlng.lng.toFixed(6);
        fetchPhotos();
      });

      // Initial query
      fetchPhotos();
    }

    function updateRadius(val) {
      document.getElementById('radius-val').innerText = val + ' km';
      if (searchCircle) {
        searchCircle.setRadius(val * 1000); // Leaflet radius is in meters
      }
    }

    function setCoordinates(lat, lon, radius) {
      document.getElementById('map-lat').value = lat;
      document.getElementById('map-lon').value = lon;
      document.getElementById('map-radius').value = radius;
      updateRadius(radius);
      map.setView([lat, lon], 11);
      fetchPhotos();
    }

    async function fetchPhotos() {
      const lat = parseFloat(document.getElementById('map-lat').value);
      const lon = parseFloat(document.getElementById('map-lon').value);
      const radius = parseFloat(document.getElementById('map-radius').value);

      if (isNaN(lat) || isNaN(lon) || isNaN(radius)) {
        alert('Please enter valid coordinates and radius');
        return;
      }

      const fetchBtn = document.getElementById('fetch-btn');
      const statsText = document.getElementById('stats-text');
      const apiCallUrl = document.getElementById('api-call-url');

      fetchBtn.disabled = true;
      fetchBtn.innerText = '⏳ Querying Database...';
      statsText.innerText = 'Executing Great-Circle DISTANCE query on MySQL...';

      // Update or create search circle
      if (searchCircle) {
        map.removeLayer(searchCircle);
      }
      searchCircle = L.circle([lat, lon], {
        color: '#0284c7',
        fillColor: '#38bdf8',
        fillOpacity: 0.15,
        radius: radius * 1000 // km to meters
      }).addTo(map);

      // Clear previous markers
      markersLayer.clearLayers();

      const startTime = performance.now();
      const endpoint = `/data/${lat}/${lon}/${radius}`;
      apiCallUrl.innerHTML = `<code>GET ${endpoint}</code>`;

      try {
        const response = await fetch(endpoint);
        if (!response.ok) {
          throw new Error(`Server returned HTTP ${response.status}`);
        }
        const data = await response.json();
        const duration = (performance.now() - startTime).toFixed(0);

        statsText.innerHTML = `✅ Found <b>${data.length.toLocaleString()}</b> photos in <b>${duration}ms</b>.`;

        // Render markers
        data.forEach(photo => {
          const marker = L.circleMarker([photo.lat, photo.lon], {
            radius: 5,
            fillColor: '#ef4444',
            color: '#ffffff',
            weight: 1.5,
            opacity: 1,
            fillOpacity: 0.85
          });

          // Bind popup that queries metadata on click
          marker.bindPopup(`
            <div style="font-family: var(--font-family); min-width: 200px;">
              <div style="font-size: 0.75rem; color: #64748b; font-weight: 600;">PHOTO ID: ${photo.pid}</div>
              <div id="popup-content-${photo.pid}" style="margin-top: 0.4rem;">
                <div style="color: #64748b; font-size: 0.8rem;">Loading photo details...</div>
              </div>
            </div>
          `);

          marker.on('click', () => loadPhotoDetails(photo.pid));
          markersLayer.addLayer(marker);
        });

      } catch (err) {
        statsText.innerHTML = `<span style="color: #ef4444;">❌ Error: ${err.message}</span>`;
      } finally {
        fetchBtn.disabled = false;
        fetchBtn.innerText = '🔍 Query Photos';
      }
    }

    async function loadPhotoDetails(pid) {
      const container = document.getElementById(`popup-content-${pid}`);
      if (!container) return;

      try {
        const res = await fetch(`/data/photoDescription/${pid}`);
        const data = await res.json();
        if (data && data.length > 0) {
          const photo = data[0];
          let decodedTitle = photo.description ? decodeURIComponent(photo.description.replace(/\+/g, ' ')) : 'Untitled';
          let imgHtml = photo.download_url ? `<img src="${photo.download_url}" style="width: 100%; max-height: 120px; object-fit: cover; border-radius: 4px; margin: 4px 0;" onerror="this.style.display='none'">` : '';

          container.innerHTML = `
            ${imgHtml}
            <div style="font-weight: 700; font-size: 0.9rem; margin-top: 2px;">${decodedTitle}</div>
            <div style="margin-top: 4px; font-size: 0.75rem;">
              <span style="background: #e0f2fe; color: #0284c7; padding: 2px 6px; border-radius: 4px; font-weight: 600;">📷 ${photo.device || 'Unknown Camera'}</span>
            </div>
            <div style="margin-top: 6px;">
              <a href="/examples/photo/${photo.pid}" target="_blank" style="font-size: 0.75rem; color: #0284c7; font-weight: 600; text-decoration: none;">View Full Details & JSON →</a>
            </div>
          `;
        } else {
          container.innerHTML = '<div style="font-size: 0.8rem; color: #64748b;">No metadata available.</div>';
        }
      } catch (e) {
        container.innerHTML = '<div style="font-size: 0.8rem; color: #ef4444;">Failed to load details.</div>';
      }
    }

    function switchCodeTab(btn, panelId) {
      const parent = btn.closest('.coursework-box');
      parent.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      parent.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(panelId).classList.add('active');
    }

    window.addEventListener('DOMContentLoaded', initMap);
  </script>
</body>
</html>

