<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Map Demo • Flickr Photo API</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <script src="/js/modal.js"></script>
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="/" class="nav-brand">
        <span>Flickr Photo API</span>
        <span class="brand-badge">CASA0017</span>
      </a>
      <ul class="nav-links">
        <li><a href="/" class="nav-link">API Explorer</a></li>
        <li><a href="/examples/map" class="nav-link active">Map Demo</a></li>
        <li><a href="/examples/cameras" class="nav-link">Top Cameras</a></li>
        <li><a href="/examples/photo/4279893539" class="nav-link">Photo Lookup</a></li>
      </ul>
    </div>
  </nav>

  <main class="main-wrapper" style="padding-bottom: 2rem;">

    <header class="page-intro" style="margin-bottom: 1.25rem;">
      <div class="page-eyebrow">Interactive Example • Workshops 8 &amp; 9</div>
      <h1 class="page-title">Spatial Radius Map Demo</h1>
      <p class="page-desc">
        Click anywhere on the map or adjust the coordinates below to call <code>GET /data/:lat/:lon/:radius</code>. Click any marker to load its metadata from <code>GET /data/photoDescription/:pid</code>.
      </p>
    </header>

    <div class="map-layout">
      <!-- Left: Simple Controls & Code -->
      <aside class="map-controls-panel">
        <div class="form-group">
          <span class="form-label">City Presets</span>
          <div class="quick-pills" style="margin-top: 0.2rem;">
            <button type="button" class="quick-pill" onclick="setCoordinates(51.5074, -0.1278, 10)">London</button>
            <button type="button" class="quick-pill" onclick="setCoordinates(53.4808, -2.2426, 15)">Manchester</button>
            <button type="button" class="quick-pill" onclick="setCoordinates(55.9533, -3.1883, 15)">Edinburgh</button>
            <button type="button" class="quick-pill" onclick="setCoordinates(51.4545, -2.5879, 15)">Bristol</button>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.65rem;">
          <div class="form-group">
            <label class="form-label" for="map-lat">Latitude</label>
            <input type="number" step="any" id="map-lat" class="form-input" value="51.5074">
          </div>
          <div class="form-group">
            <label class="form-label" for="map-lon">Longitude</label>
            <input type="number" step="any" id="map-lon" class="form-input" value="-0.1278">
          </div>
        </div>

        <div class="form-group">
          <div style="display: flex; justify-content: space-between; align-items: center;">
            <label class="form-label" for="map-radius">Radius (km)</label>
            <span id="radius-val" style="font-family: var(--font-mono); font-size: 0.82rem; font-weight: 600; color: var(--primary);">10 km</span>
          </div>
          <input type="range" id="map-radius" min="1" max="50" value="10" style="width: 100%; cursor: pointer;" oninput="updateRadius(this.value)">
        </div>

        <button type="button" class="btn btn-primary" id="fetch-btn" onclick="fetchPhotos()" style="width: 100%;">
          Search Photos
        </button>

        <!-- Clean API Status Box -->
        <div style="background: var(--bg-page); border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.85rem; font-size: 0.84rem;">
          <div id="stats-text" style="color: var(--text-secondary);">Ready to search.</div>
          <div id="api-call-url" style="font-family: var(--font-mono); font-size: 0.76rem; color: var(--primary); margin-top: 0.35rem; word-break: break-all;"></div>
        </div>

        <!-- Compact Code Reference -->
        <div style="margin-top: auto; border: 1px solid var(--border-color); border-radius: var(--radius-md); overflow: hidden;">
          <div class="response-tabs">
            <button type="button" class="tab-btn active" style="padding: 0.45rem 0.75rem; font-size: 0.76rem;" onclick="switchCodeTab(this, 'code-fetch')">fetch()</button>
            <button type="button" class="tab-btn" style="padding: 0.45rem 0.75rem; font-size: 0.76rem;" onclick="switchCodeTab(this, 'code-jquery')">jQuery</button>
          </div>
          <div id="code-fetch" class="tab-panel active" style="padding: 0;">
            <pre class="code-block" style="background: var(--bg-code); padding: 0.75rem; font-size: 0.74rem; max-height: 170px;">fetch(`/data/${lat}/${lon}/${radius}`)
  .then(res => res.json())
  .then(photos => {
    photos.forEach(p => {
      L.marker([p.lat, p.lon]).addTo(map);
    });
  });</pre>
          </div>
          <div id="code-jquery" class="tab-panel" style="padding: 0;">
            <pre class="code-block" style="background: var(--bg-code); padding: 0.75rem; font-size: 0.74rem; max-height: 170px;">$.getJSON(`/data/${lat}/${lon}/${radius}`, function(photos) {
  $.each(photos, function(i, p) {
    L.marker([p.lat, p.lon]).addTo(map);
  });
});</pre>
          </div>
        </div>
      </aside>

      <!-- Right: Map -->
      <div class="map-view-panel">
        <div id="map-container"></div>
      </div>
    </div>

  </main>

  <footer class="footer">
    <div class="footer-content">
      <div><strong>UCL Centre for Advanced Spatial Analysis (CASA)</strong> • CASA0017 Web Architecture</div>
      <div>Flickr Spatial &amp; Metadata API</div>
    </div>
  </footer>

  <script>
    let map, searchCircle;
    let markersLayer = L.layerGroup();

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function initMap() {
      map = L.map('map-container').setView([51.5074, -0.1278], 11);

      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
      }).addTo(map);

      markersLayer.addTo(map);

      map.on('click', function(e) {
        document.getElementById('map-lat').value = e.latlng.lat.toFixed(6);
        document.getElementById('map-lon').value = e.latlng.lng.toFixed(6);
        fetchPhotos();
      });

      fetchPhotos();
    }

    function updateRadius(val) {
      document.getElementById('radius-val').textContent = val + ' km';
      if (searchCircle) {
        searchCircle.setRadius(val * 1000);
      }
    }

    function setCoordinates(lat, lon, radius) {
      document.getElementById('map-lat').value = lat;
      document.getElementById('map-lon').value = lon;
      document.getElementById('map-radius').value = radius;
      updateRadius(radius);
      map.setView([lat, lon], 11);
      fetchPhotos();
    }

    async function fetchPhotos() {
      const lat = parseFloat(document.getElementById('map-lat').value);
      const lon = parseFloat(document.getElementById('map-lon').value);
      const radius = parseFloat(document.getElementById('map-radius').value);

      if (isNaN(lat) || isNaN(lon) || isNaN(radius)) {
        alert('Please enter valid coordinates and radius.');
        return;
      }

      const fetchBtn = document.getElementById('fetch-btn');
      const statsText = document.getElementById('stats-text');
      const apiCallUrl = document.getElementById('api-call-url');

      fetchBtn.disabled = true;
      fetchBtn.textContent = 'Searching...';
      statsText.textContent = 'Querying database...';

      if (searchCircle) {
        map.removeLayer(searchCircle);
      }
      searchCircle = L.circle([lat, lon], {
        color: '#2563eb',
        weight: 2,
        fillColor: '#3b82f6',
        fillOpacity: 0.12,
        radius: radius * 1000
      }).addTo(map);

      markersLayer.clearLayers();

      const startTime = performance.now();
      const endpoint = `/data/${lat}/${lon}/${radius}`;
      apiCallUrl.textContent = `GET ${endpoint}`;

      try {
        const response = await fetch(endpoint);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const data = await response.json();
        const duration = Math.round(performance.now() - startTime);

        statsText.innerHTML = `Found <strong>${data.length.toLocaleString()}</strong> photos (${duration} ms)`;

        data.forEach(photo => {
          const marker = L.circleMarker([photo.lat, photo.lon], {
            radius: 5,
            fillColor: '#e11d48',
            color: '#ffffff',
            weight: 1.5,
            opacity: 1,
            fillOpacity: 0.85
          });

          marker.bindPopup(`
            <div style="font-family: var(--font-sans); min-width: 190px;">
              <div style="font-size: 0.72rem; color: #64748b; font-weight: 600;">Photo ID: ${photo.pid}</div>
              <div id="popup-content-${photo.pid}" style="margin-top: 0.35rem; font-size: 0.8rem; color: #64748b;">
                Loading metadata...
              </div>
            </div>
          `);

          marker.on('click', () => loadPhotoDetails(photo.pid));
          markersLayer.addLayer(marker);
        });
      } catch (err) {
        statsText.innerHTML = `<span style="color: var(--danger);">Error: ${escapeHtml(err.message)}</span>`;
      } finally {
        fetchBtn.disabled = false;
        fetchBtn.textContent = 'Search Photos';
      }
    }

    async function loadPhotoDetails(pid) {
      const container = document.getElementById(`popup-content-${pid}`);
      if (!container) return;

      try {
        const res = await fetch(`/data/photoDescription/${pid}`);
        const data = await res.json();
        if (data && data.length > 0) {
          const photo = data[0];
          let decodedTitle = 'Untitled';
          try {
            decodedTitle = photo.description ? decodeURIComponent(photo.description.replace(/\+/g, ' ')) : 'Untitled';
          } catch {
            decodedTitle = photo.description || 'Untitled';
          }
          const imgHtml = photo.download_url
            ? `<img src="${escapeHtml(photo.download_url)}" style="width: 100%; max-height: 110px; object-fit: cover; border-radius: 4px; margin: 4px 0;" onerror="this.style.display='none'">`
            : '';

          container.innerHTML = `
            ${imgHtml}
            <div style="font-weight: 600; font-size: 0.86rem; color: #0f172a;">${escapeHtml(decodedTitle)}</div>
            <div style="margin-top: 4px; font-size: 0.75rem; color: #2563eb; font-weight: 500;">${escapeHtml(photo.device || 'Unknown Camera')}</div>
            <div style="margin-top: 6px;">
              <a href="/examples/photo/${photo.pid}" style="font-size: 0.75rem; color: #2563eb; font-weight: 600; text-decoration: none;">Inspect Photo →</a>
            </div>
          `;
        } else {
          container.innerHTML = 'No metadata found.';
        }
      } catch {
        container.innerHTML = 'Failed to load metadata.';
      }
    }

    function switchCodeTab(btn, panelId) {
      const parent = btn.parentElement.parentElement;
      parent.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      parent.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById(panelId).classList.add('active');
    }

    window.addEventListener('DOMContentLoaded', initMap);
  </script>
</body>
</html>
